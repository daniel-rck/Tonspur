{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "extends": ["./biome.base.json"],
  "overrides": [
    {
      "includes": [
        "src/features/game/movies.ts",
        "src/features/game/movie-links.ts",
        "src/features/game/game.css"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.generated.ts"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
